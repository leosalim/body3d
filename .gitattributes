# Normalise text files in the repository; check them out per platform.
* text=auto

# These run inside Linux containers. A CRLF checkout on Windows makes the
# kernel fail to find the interpreter ("no such file or directory" on a shebang
# that is plainly there), so they must stay LF everywhere.
*.sh            text eol=lf
*.py            text eol=lf
*.tmpl          text eol=lf
mvnw            text eol=lf
Dockerfile      text eol=lf
*.Dockerfile    text eol=lf
Jenkinsfile     text eol=lf
docker-entrypoint*  text eol=lf
docker/**/*.sql text eol=lf
infra/**        text eol=lf
*.env.example   text eol=lf

# Windows-only launchers stay CRLF.
*.cmd           text eol=crlf
*.bat           text eol=crlf
*.ps1           text eol=crlf

# Binary — never touched.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.woff          binary
*.woff2         binary
*.jar           binary
*.glb           binary
*.ttf           binary
*.pdf           binary
*.xlsx          binary
*.webp          binary
